# =============================================================================
# Never Twice - environment template.  Copy to `.env` and fill in.
#   cp .env.example .env
# Nothing in this file is a secret; real secrets belong only in `.env`.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=local
# Bind address for the FastAPI backend.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# Comma-separated origins allowed to call the API from a browser.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Where the SQLite file lives (override with a postgresql+psycopg:// URL for prod).
DATABASE_URL=sqlite:///./data/app.db
# Public URL of this backend, used when posting GitHub PR comments.
PUBLIC_BACKEND_URL=http://127.0.0.1:8000

# -----------------------------------------------------------------------------
# LLM - OpenAI-compatible chat completions
# -----------------------------------------------------------------------------
# `groq` and `ollama` both speak the OpenAI API. Leave LLM_PROVIDER=ollama to run
# fully offline against a local Ollama daemon; set LLM_PROVIDER=groq plus
# GROQ_API_KEY to use Groq instead. Task tuning lives in config/llm.yaml; model
# chains come from GROQ_MODEL/GROQ_FALLBACK_MODEL (or LLM_MODEL for ollama).
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434/v1
# Provider-default models; config/llm.yaml may still pin a per-task chain.
LLM_MODEL=llama3.2:latest
LLM_FALLBACK_MODEL=llama3:latest
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=180
LLM_MAX_RETRIES=3

# Groq (only used when LLM_PROVIDER=groq). REQUIRED for the evaluation harness at
# its documented quality level; the local Ollama path is a lower-fidelity fallback.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=qwen/qwen3-32b

# -----------------------------------------------------------------------------
# Hindsight (organizational memory)
# -----------------------------------------------------------------------------
# Point at a local server (see scripts/start-hindsight.sh) or Hindsight Cloud.
HINDSIGHT_BASE_URL=http://127.0.0.1:8888
# Needed only for Hindsight Cloud.
HINDSIGHT_API_KEY=
# The production memory bank. Held-out incidents are NEVER retained here.
HINDSIGHT_BANK_ID=nevertwice-prod
HINDSIGHT_TIMEOUT_SECONDS=300

# -----------------------------------------------------------------------------
# Server-side Hindsight process configuration (used by scripts/start-hindsight.sh)
# -----------------------------------------------------------------------------
HINDSIGHT_API_LLM_PROVIDER=ollama
HINDSIGHT_API_LLM_MODEL=qwen2.5:7b
HINDSIGHT_API_LLM_BASE_URL=http://127.0.0.1:11434/v1
HINDSIGHT_API_LLM_API_KEY=
HINDSIGHT_API_EMBEDDINGS_PROVIDER=onnx
HINDSIGHT_API_RERANKER_PROVIDER=flashrank
HINDSIGHT_API_RETAIN_MAX_COMPLETION_TOKENS=16000
HINDSIGHT_API_HOST=127.0.0.1
HINDSIGHT_API_PORT=8888

# -----------------------------------------------------------------------------
# GitHub webhook (optional; the UI path works without it)
# -----------------------------------------------------------------------------
# Secret used to verify the X-Hub-Signature-256 header. Required for the webhook.
GITHUB_WEBHOOK_SECRET=
# Personal access token with `repo` scope, used to post PR comments.
GITHUB_TOKEN=
GITHUB_API_URL=https://api.github.com

# -----------------------------------------------------------------------------
# Feedback signing
# -----------------------------------------------------------------------------
FEEDBACK_SIGNING_SECRET=change-me-in-real-deployments

# -----------------------------------------------------------------------------
# Ingestion
# -----------------------------------------------------------------------------
# Max seconds to wait for a single source article before marking it failed.
INGEST_FETCH_TIMEOUT_SECONDS=30
INGEST_USER_AGENT=NeverTwiceBot/0.1 (+https://github.com/never-twice)
# Retain to Hindsight asynchronously (recommended; the server returns an op id).
HINDSIGHT_RETAIN_ASYNC=true

# Reflect built-in deadline is 30s; local CPU models need far more (start-hindsight.sh exports 900 by default).
HINDSIGHT_API_LLM_TIMEOUT=900
